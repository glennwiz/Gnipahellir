// Which equip slot an item occupies; absent (= .None) is not equippable.
// Stat bonuses stay hand-owned in items.odin (they reference named constants).
@(rodata)
item_equip_slot := #partial [Item]Equip_Slot{
	.Sword = .Weapon,
	.Pickaxe = .Tool,
	// Wands and swords compete for the weapon slot. The pickaxe has its own
	// Tool slot, so changing combat/ranged gear never puts the pick away.
	.Mine_Wand = .Weapon,
	.Mine_Wand_Silver = .Weapon,
	.Mine_Wand_Gold = .Weapon,
	.Aether_Charm = .Charm,
	.Silver_Sword = .Weapon,
	.Gold_Sword = .Weapon,
	.Iron_Helm = .Head,
	.Silver_Helm = .Head,
	.Gold_Helm = .Head,
	.Iron_Chestplate = .Chest,
	.Silver_Chestplate = .Chest,
	.Gold_Chestplate = .Chest,
	.Iron_Gauntlets = .Hands,
	.Silver_Gauntlets = .Hands,
	.Gold_Gauntlets = .Hands,
	.Iron_Greaves = .Legs,
	.Silver_Greaves = .Legs,
	.Gold_Greaves = .Legs,
	.Iron_Boots = .Feet,
	.Silver_Boots = .Feet,
	.Gold_Boots = .Feet,
	.Mine_Wand_Runic = .Weapon,
	.Runic_Sword = .Weapon,
	.Runic_Helm = .Head,
	.Runic_Chestplate = .Chest,
	.Runic_Gauntlets = .Hands,
	.Runic_Greaves = .Legs,
	.Runic_Boots = .Feet,
	.Void_Charm = .Charm,
	.Command_Wand = .Weapon,
	.Command_Wand_Emerald = .Weapon,
	.Command_Wand_Hel = .Weapon,
	.Jade_Ring = .Charm,
	.Fire_Wand = .Weapon,
